{
  "status": "ready",
  "title": "Atoms and Molecules: What’s the Difference?",
  "target_duration_seconds": 240,
  "scenes": [
    {
      "id": "scene_1",
      "purpose": "Build intuition by defining an atom as one basic unit of an element.",
      "pedagogy_beat_ids": [
        "pedagogy_plan.learning_objectives[0]",
        "pedagogy_plan.teaching_sequence[0]"
      ],
      "estimated_duration_seconds": 48.0,
      "narration_segments": [
        {
          "id": "narr_1_1",
          "text": "To compare atoms and molecules, start with the atom.",
          "source_ids": [
            "verified_chemistry.reasoning_steps[0]"
          ]
        },
        {
          "id": "narr_1_2",
          "text": "An atom is the smallest unit of an element that still has that element’s chemical identity.",
          "source_ids": [
            "verified_chemistry.concepts[0]",
            "verified_chemistry.learning_objectives[0]"
          ]
        },
        {
          "id": "narr_1_3",
          "text": "So one hydrogen atom is a single particle of the element hydrogen.",
          "source_ids": [
            "verified_chemistry.reasoning_steps[0]"
          ]
        },
        {
          "id": "narr_1_4",
          "text": "One oxygen atom is a single particle of the element oxygen.",
          "source_ids": [
            "verified_chemistry.reasoning_steps[0]"
          ]
        },
        {
          "id": "narr_1_5",
          "text": "The key idea is simple: an atom is one basic unit of an element.",
          "source_ids": [
            "verified_chemistry.key_takeaways[0]",
            "verified_chemistry.reasoning_steps[4]"
          ]
        }
      ],
      "visual_beats": [
        {
          "id": "vis_1_1",
          "trigger_narration_id": "narr_1_1",
          "trigger_phrase": "start with the atom",
