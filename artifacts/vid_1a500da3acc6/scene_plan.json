    },
    {
      "id": "scene_5",
      "purpose": "Recap the simple comparison between atoms and molecules.",
      "pedagogy_beat_ids": [
        "pedagogy_plan.recap_points[0]",
        "pedagogy_plan.recap_points[1]",
        "pedagogy_plan.recap_points[2]"
      ],
      "estimated_duration_seconds": 33.0,
      "narration_segments": [
        {
          "id": "narr_5_1",
          "text": "So the shortest comparison is this.",
          "source_ids": [
            "verified_chemistry.reasoning_steps[4]"
          ]
        },
        {
          "id": "narr_5_2",
          "text": "An atom is one basic unit of an element.",
          "source_ids": [
            "verified_chemistry.key_takeaways[0]",
            "verified_chemistry.reasoning_steps[4]"
          ]
        },
        {
          "id": "narr_5_3",
          "text": "A molecule is two or more atoms chemically bonded together.",
          "source_ids": [
            "verified_chemistry.key_takeaways[1]",
            "verified_chemistry.concepts[1]"
          ]
        },
        {
          "id": "narr_5_4",
          "text": "O2 shows that a molecule can have atoms of the same element.",
          "source_ids": [
            "verified_chemistry.reasoning_steps[2]",
            "verified_chemistry.concepts[2]"
          ]
        },
        {
          "id": "narr_5_5",
          "text": "H2O shows that a molecule can have atoms of different elements.",
          "source_ids": [
            "verified_chemistry.reasoning_steps[3]",
            "verified_chemistry.concepts[2]"
          ]
        },
        {
          "id": "narr_5_6",
          "text": "Keep that difference in mind, and atom versus molecule becomes much clearer.",
          "source_ids": [
            "verified_chemistry.reasoning_steps[4]"
          ]
        }
      ],
