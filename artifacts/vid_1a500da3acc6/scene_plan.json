            "verified_chemistry.reasoning_steps[3]"
          ]
        },
        {
          "id": "vis_3_8",
          "trigger_narration_id": "narr_3_8",
          "trigger_phrase": "same kind of atom or different kinds",
          "action": "Show O2 and H2O side by side with a shared heading that both are molecules.",
          "visual_type": "comparison_table",
          "on_screen_text": "Molecules can vary",
          "source_ids": [
            "verified_chemistry.key_takeaways[2]"
          ]
        }
      ]
    },
    {
      "id": "scene_4",
      "purpose": "Correct key misconceptions about molecules and substances.",
      "pedagogy_beat_ids": [
        "pedagogy_plan.misconceptions_to_correct[0]",
        "pedagogy_plan.misconceptions_to_correct[1]",
        "pedagogy_plan.misconceptions_to_correct[2]",
        "pedagogy_plan.learning_objectives[3]"
      ],
      "estimated_duration_seconds": 52.0,
      "narration_segments": [
        {
          "id": "narr_4_1",
          "text": "Here are three common traps to avoid.",
          "source_ids": [
            "verified_chemistry.common_misconceptions[0]",
            "verified_chemistry.common_misconceptions[1]",
            "verified_chemistry.common_misconceptions[2]"
          ]
        },
        {
          "id": "narr_4_2",
          "text": "First, all compounds are not the same idea as all molecules.",
          "source_ids": [
            "verified_chemistry.common_misconceptions[0]"
          ]
        },
        {
          "id": "narr_4_3",
          "text": "An oxygen molecule, O2, has only one element, so it is not a compound.",
          "source_ids": [
            "verified_chemistry.common_misconceptions[0]",
            "verified_chemistry.reasoning_steps[2]"
          ]
        },
        {
          "id": "narr_4_4",
          "text": "Second, not all substances are made of separate molecules.",
          "source_ids": [
            "verified_chemistry.concepts[3]",
            "verified_chemistry.common_misconceptions[1]"
          ]
        },
        {
          "id": "narr_4_5",
          "text": "Salts like sodium chloride form large repeating ionic structures rather than individual molecules.",
          "source_ids": [
            "verified_chemistry.concepts[3]"
          ]
        },
        {
          "id": "narr_4_6",
          "text": "Third, an atom is not always found alone.",
          "source_ids": [
            "verified_chemistry.common_misconceptions[2]"
          ]
        },
        {
          "id": "narr_4_7",
          "text": "Many atoms are usually found bonded to other atoms in molecules or larger structures.",
          "source_ids": [
            "verified_chemistry.common_misconceptions[2]"
          ]
        }
      ],
      "visual_beats": [
        {
          "id": "vis_4_1",
          "trigger_narration_id": "narr_4_1",
          "trigger_phrase": "three common traps",
          "action": "Show three short misconception cards labeled molecule, substance, and atom.",
          "visual_type": "text",
          "on_screen_text": "Three common traps",
          "source_ids": [
            "verified_chemistry.common_misconceptions[0]",
            "verified_chemistry.common_misconceptions[1]",
            "verified_chemistry.common_misconceptions[2]"
          ]
        },
        {
