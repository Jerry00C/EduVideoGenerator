          "visual_type": "comparison_table",
          "on_screen_text": "Molecule ≠ always compound",
          "source_ids": [
            "verified_chemistry.common_misconceptions[0]"
          ]
        },
        {
          "id": "vis_4_3",
          "trigger_narration_id": "narr_4_3",
